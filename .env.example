# --- Storage (SQLite by default; use Postgres in production: pip install psycopg2-binary) ---
# DATABASE_URL=postgresql://user:pass@host:5432/founderos
BUSINESS_TZ=Asia/Kolkata
BRAND_NAME=INHAUS Coffee

# --- Webhook auth (set all three in production; unsigned requests are rejected unless ALLOW_UNSIGNED_WEBHOOKS=1) ---
SHOPIFY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_WEBHOOK_TOKEN=
ALLOW_UNSIGNED_WEBHOOKS=0

# --- Protects "Run workflow" and /ingest/meta-ads (send as X-Admin-Key). Empty = open (dev only). ---
ADMIN_API_KEY=

# --- AI insights (falls back to a rules engine when empty) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Slack delivery: bot token + channel uploads the PDF; or an incoming webhook sends text only ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=

# --- Meta Ads pull (optional; otherwise POST rows to /ingest/meta-ads) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Margin assumptions ---
DEFAULT_COGS_RATIO=0.42
